# Dependencies
node_modules/

# Build output
dist/
lib/
build/
*.tsbuildinfo

# Dev build scratch (dev/build-ui.mjs)
dev/.build/

# Logs and local tooling
*.log
npm-debug.log*
pnpm-debug.log*
.tools/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Env and local config
.env
.env.*
!.env.example

# The sub-bundles ship vendored, prebuilt client/host entries. The generic
# lib/ ignore above is for this package's own build output, not those vendors.
!bundles/**/vendor/**/lib/
!bundles/**/vendor/**/lib/**
